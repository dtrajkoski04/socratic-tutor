{
  "name": "socratic-tutor",
  "displayName": "Code Didaktik Tutor",
  "description": "Sokratischer KI-Tutor zur Förderung des Codeverständnisses",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": ["Education", "Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeTutor.explain",
        "title": "Code Tutor: Code erklären"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "^20.0.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "openai": "^4.47.0"
  }
}